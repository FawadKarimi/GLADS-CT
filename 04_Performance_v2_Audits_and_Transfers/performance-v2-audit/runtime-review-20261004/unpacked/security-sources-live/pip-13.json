p","cve_id":"CVE-2026-1703","url":"https://api.github.com/advisories/GHSA-6vgw-5pg2-w6jp","html_url":"https://github.com/advisories/GHSA-6vgw-5pg2-w6jp","summary":"pip Path Traversal vulnerability","description":"When pip is installing and extracting a maliciously crafted wheel archive, files may be extracted outside the installation directory. The path traversal is limited to prefixes of the installation directory, thus isn't able to inject or overwrite executable files in typical situations.","type":"reviewed","severity":"low","repository_advisory_url":null,"source_code_location":"https://github.com/pypa/pip","identifiers":[{"value":"GHSA-6vgw-5pg2-w6jp","type":"GHSA"},{"value":"CVE-2026-1703","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/detail/CVE-2026-1703","https://github.com/pypa/pip/pull/13777","https://github.com/pypa/pip/commit/8e227a9be4faa9594e05d02ca05a413a2a4e7735","https://mail.python.org/archives/list/security-announce@python.org/thread/WIEA34D4TABF2UNQJAOMXKCICSPBE2DJ","https://github.com/advisories/GHSA-6vgw-5pg2-w6jp"],"published_at":"2026-02-02T15:30:34Z","updated_at":"2026-02-02T22:08:55Z","github_reviewed_at":"2026-02-02T22:08:51Z","nvd_published_at":"2026-02-02T15:16:30Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pip"},"vulnerable_version_range":"< 26.0","first_patched_version":"26.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":null,"score":0.0},"cvss_v4":{"vector_string":"CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:A/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N","score":2.0}},"cwes":[{"cwe_id":"CWE-22","name":"Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"}],"credits":[],"cvss":{"vector_string":null,"score":null},"epss":{"percentage":0.00414,"percentile":0.3297}},{"ghsa_id":"GHSA-4xh5-x5gv-qwph","cve_id":"CVE-2025-8869","url":"https://api.github.com/advisories/GHSA-4xh5-x5gv-qwph","html_url":"https://github.com/advisories/GHSA-4xh5-x5gv-qwph","summary":"pip's fallback tar extraction doesn't check symbolic links point to extraction directory","description":"When extracting a tar archive pip may not check symbolic links point into the extraction directory if the tarfile module doesn't implement PEP 706. Note that upgrading pip to a \"fixed\" version for this vulnerability doesn't fix all known vulnerabilities that are remediated by using a Python version that implements PEP 706. Note that this is a vulnerability in pip's fallback implementation of tar extraction for Python versions that don't implement PEP 706 and therefore are not secure to all vulnerabilities in the Python 'tarfile' module. If you're using a Python version that implements PEP 706 then pip doesn't use the \"vulnerable\" fallback code. Mitigations include upgrading to a version of pip that includes the fix, upgrading to a Python version that implements PEP 706 (Python >=3.9.17, >=3.10.12, >=3.11.4, or >=3.12), applying the linked patch, or inspecting source distributions (sdists) before installation as is already a best-practice.","type":"reviewed","severity":"medium","repository_advisory_url":null,"source_code_location":"https://github.com/pypa/pip","identifiers":[{"value":"GHSA-4xh5-x5gv-qwph","type":"GHSA"},{"value":"CVE-2025-8869","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/detail/CVE-2025-8869","https://github.com/pypa/pip/pull/13550","https://mail.python.org/archives/list/security-announce@python.org/thread/IF5A3GCJY3VH7BVHJKOWOJFKTW7VFQEN","https://github.com/pypa/pip/commit/f2b92314da012b9fffa36b3f3e67748a37ef464a","https://pip.pypa.io/en/stable/news/#v25-2","https://lists.debian.org/debian-lts-announce/2025/10/msg00028.html","https://github.com/advisories/GHSA-4xh5-x5gv-qwph"],"published_at":"2025-09-24T15:31:14Z","updated_at":"2025-12-19T16:46:02Z","github_reviewed_at":"2025-09-24T20:04:58Z","nvd_published_at":"2025-09-24T15:15:41Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"pip","name":"pip"},"vulnerable_version_ran